# ═══════════════════════════════════════════════════════════════════════════
# Root .env — the ONLY file `docker compose` reads.
# ═══════════════════════════════════════════════════════════════════════════
#
# Copy to `.env` (which is gitignored) before `npm run infra:up`.
#
# This file exists because its absence caused a real outage. Compose resolves
# `${REDIS_PASSWORD:-change_me_in_development}` from THIS file — it never reads
# apps/api/.env, which is what the services themselves load. With no root .env,
# Compose silently used the fallback while the services sent the password from
# apps/api/.env, and every Redis call failed with WRONGPASS.
#
# The failure was invisible for a second reason worth knowing:
#
#   * Postgres writes its password into the data directory at first init, so it
#     kept accepting the old password from its persisted volume and looked fine.
#   * Redis takes `--requirepass` from the command line on EVERY start, so it
#     adopted the fallback the moment the container was recreated.
#
# Same missing file, one service unaffected and one broken — which is why this
# looked like a Redis bug rather than a configuration one.
#
# Keep the secrets below in step with apps/api/.env. They are two files that
# must agree; nothing enforces it.

# ── Platform Postgres (shared) ─────────────────────────────────────────────
# Must match DB_USER / DB_PASSWORD / DB_NAME in apps/api/.env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_development
POSTGRES_DB=kartseek_db

# ── Redis ──────────────────────────────────────────────────────────────────
# Must match REDIS_PASSWORD in apps/api/.env.
REDIS_PASSWORD=change_me_in_development

# ── Per-module Postgres (docker compose --profile isolated up -d) ──────────
# Each of these is baked into its volume on first start. Changing a password
# here does NOT change an existing database — you must recreate that volume
# (`docker compose down -v` drops data) or ALTER the role by hand.
MARKETPLACE_DB_USER=marketplace_user
MARKETPLACE_DB_PASSWORD=change_me_in_development
MARKETPLACE_DB_NAME=kartseek_marketplace
GROCERY_DB_USER=grocery_user
GROCERY_DB_PASSWORD=change_me_in_development
GROCERY_DB_NAME=kartseek_grocery
RESTAURANT_DB_USER=restaurant_user
RESTAURANT_DB_PASSWORD=change_me_in_development
RESTAURANT_DB_NAME=kartseek_restaurant
PHARMACY_DB_USER=pharmacy_user
PHARMACY_DB_PASSWORD=change_me_in_development
PHARMACY_DB_NAME=kartseek_pharmacy
DOCTOR_DB_USER=doctor_user
DOCTOR_DB_PASSWORD=change_me_in_development
DOCTOR_DB_NAME=kartseek_doctor
HOTEL_DB_USER=hotel_user
HOTEL_DB_PASSWORD=change_me_in_development
HOTEL_DB_NAME=kartseek_hotel
TAXI_DB_USER=taxi_user
TAXI_DB_PASSWORD=change_me_in_development
TAXI_DB_NAME=kartseek_taxi
FRANCHISE_DB_USER=franchise_user
FRANCHISE_DB_PASSWORD=change_me_in_development
FRANCHISE_DB_NAME=kartseek_franchise

# ── Mongo / pgAdmin (tools profile) ────────────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change_me_in_development
MONGO_DB_NAME=kartseek_catalog
PGADMIN_EMAIL=admin@kartseek.com
PGADMIN_PASSWORD=change_me_in_development
