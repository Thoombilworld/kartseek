# ═══════════════════════════════════════════════════════════════════════════════
# KARTSEEK — Local Development Environment Variables
# ⚠️  DO NOT COMMIT THIS FILE — Add to .gitignore
# 
# Copy from .env.example and customize for your local environment
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database Credentials (CHANGE THESE!) ────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=kartseek_db

# ── PostgreSQL (Marketplace) ───────────────────────────────────────────────
MARKETPLACE_DB_USER=marketplace_user
MARKETPLACE_DB_PASSWORD=your_secure_marketplace_password_here
MARKETPLACE_DB_NAME=kartseek_marketplace

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=your_secure_redis_password_here

# ── MongoDB ────────────────────────────────────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=your_secure_mongo_password_here
MONGO_DB_NAME=kartseek_catalog

# ── pgAdmin ────────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@kartseek.local
PGADMIN_PASSWORD=your_secure_pgadmin_password_here

# ── Application Settings ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_GATEWAY_PORT=3001
SKIP_DB=false

# ── Kafka ──────────────────────────────────────────────────────────────────
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=kartseek-api
KAFKA_GROUP_ID=kartseek-consumer

# ── JWT / Auth (CHANGE THESE!) ─────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production-12345
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production-12345
JWT_REFRESH_EXPIRES_IN=7d

# ── Trading markets ────────────────────────────────────────────────────────
# Which countries the storefront offers. Comma-separated ISO 3166-1 alpha-2
# codes; unset means the home market only (QA).
#
# The localization registry describes twenty countries, but describing one is
# not trading in it: this list drives the region switcher, the region cookie,
# the proxy's region resolution and every "available in ..." line of copy.
# Countries left out stay readable — an invoice from a closed market still
# resolves its own currency and tax-id label — they just cannot be selected.
#
# MUST match the API's ACTIVE_REGIONS. If they disagree, the storefront offers
# a market the gateway rejects with a 403.
NEXT_PUBLIC_ACTIVE_REGIONS=QA
