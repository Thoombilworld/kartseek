# ══════════════════════════════════════════════════════════════════════════════
# KARTSEEK API — Environment Variables
# Copy this file to .env and fill in your values
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
SKIP_DB=false


# ── Trading markets ───────────────────────────────────────────────────────────
# Which of the region registry's countries the platform actually accepts new
# business in. Comma-separated ISO 3166-1 alpha-2 codes.
#
# Unset means the home market only (QA). The registry describes ten countries,
# but describing one is not the same as trading there: closed markets stay
# readable so existing orders, invoices and seller records keep resolving their
# own currency and tax rules, while new transactions are refused.
#
# This MUST match the web client's NEXT_PUBLIC_ACTIVE_REGIONS. If they disagree,
# the storefront offers a market the API rejects.
ACTIVE_REGIONS=QA

# ── Reverse proxy ─────────────────────────────────────────────────────────────
# How many proxies sit in front of the gateway. nginx terminates TLS and
# forwards X-Forwarded-For, but Express ignores it until this is set — and the
# rate limiter keys on the client IP, so with this unset the "per IP" limit
# applies to every client at once.
#
# A count, never "true": trusting all hops lets anyone who can reach the app
# directly forge X-Forwarded-For and take over another client's bucket.
# 1 = the single nginx we run. 0 disables it for a directly-exposed deployment.
TRUST_PROXY_HOPS=1

# ── Browser origins (CORS) ────────────────────────────────────────────────────
# The storefront origin, and any other browser origin allowed to call the
# gateway (comma-separated). kartseek.com and its subdomains are always allowed;
# localhost is allowed unless NODE_ENV=production.
#
# An origin that is missing here has its preflight refused, so the request never
# leaves the page: the browser reports a connection failure, the web client shows
# "We could not reach the sign-in service", and NOTHING appears in the gateway
# logs. The same request from curl succeeds, because curl does not enforce CORS.
WEB_APP_URL=http://localhost:3000
CORS_ORIGINS=

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# REQUIRED. There is no built-in default: every service, the migration CLI and
# the maintenance scripts refuse to start without it (AUD2-074). This file is
# tracked, so it must never carry the real one.
DB_PASSWORD=change_me_in_development
DB_NAME=kartseek_db
# Auto-schema-sync. Keep 'false': all services share one DB, so enabling this lets
# each service ALTER shared tables to match its own entities (boot-order dependent).
DB_SYNCHRONIZE=false
# Migrations against THIS database (users, order.orders, admin.*, gateway tables):
#   npm run migration:show:main -w kartseek-api   # then migration:run:main to apply
# `npm run migration:run` (no :main) uses MARKETPLACE_DB_* below, so it does NOT
# create users.admin_role_id — and without that column every staff login 500s.

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT / Auth ────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=7d

# Lets a WebSocket client open a session with `?userId=<id>` and no token, for
# local work against gateways that would otherwise refuse the connection. Such a
# session is always role CUSTOMER and can never reach an admin room. Leave unset
# anywhere real: it is ignored when NODE_ENV=production, and NODE_ENV is set by
# none of this repo's dev scripts, so staging counts as "not production".
ALLOW_WS_DEV_AUTH=false

# ── Razorpay (India Payments) ─────────────────────────────────────────────────
# Get keys: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_LIVE=false

# ── Stripe (Global Payments) ─────────────────────────────────────────────────
# Get keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_LIVE=false

# ── Cloud Storage ─────────────────────────────────────────────────────────────
# Supported providers: s3, gcs, r2, local (default: local)
STORAGE_PROVIDER=local
CDN_DOMAIN=cdn.kartseek.com
# Where the `local` provider writes PUBLIC-seam objects (product photos, logos).
# The CDN_DOMAIN URL it returns is not serving them — local is a dev provider.
STORAGE_LOCAL_DIR=

# ── Private storage (identity documents) ──────────────────────────────────────
# KYC documents — government IDs, business registrations, licence scans — are
# NOT public content and never get a CDN URL. They go to a separate private
# bucket with no public ACL and no caching, readable only through
# GET /admin/kyc/documents/:key (admin role + kyc.view + the owner's market).
#
# REQUIRED when STORAGE_PROVIDER is s3, gcs or r2: without it the upload is
# refused rather than falling back to the CDN-fronted public bucket.
STORAGE_PRIVATE_BUCKET=
# Key prefix inside that bucket. Defaults to `private/` when unset.
STORAGE_PRIVATE_PREFIX=private/
# Where the `local` provider writes them. MUST be outside any served static
# path. Defaults to <cwd>/var/private-storage.
STORAGE_PRIVATE_DIR=

# AWS S3 (when STORAGE_PROVIDER=s3)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=kartseek-uploads

# Google Cloud Storage (when STORAGE_PROVIDER=gcs)
GCLOUD_PROJECT=
GCS_KEY_FILE=
GCS_BUCKET=kartseek-uploads

# Cloudflare R2 (when STORAGE_PROVIDER=r2)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=kartseek-api
KAFKA_GROUP_ID=kartseek-consumer

# ── gRPC ──────────────────────────────────────────────────────────────────────
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# ── Microservice TCP Ports ────────────────────────────────────────────────────
MARKETPLACE_TCP_PORT=4002
CART_TCP_PORT=4003
LOYALTY_TCP_PORT=4005
FRANCHISE_TCP_PORT=4006
DOCTOR_TCP_PORT=4007
GROCERY_TCP_PORT=4008
PHARMACY_TCP_PORT=4010
LOCATION_TCP_PORT=4013
WALLET_TCP_PORT=4014
ADMIN_TCP_PORT=4017
RESTAURANT_TCP_PORT=4018
COMMISSION_TCP_PORT=4020
PAYOUT_TCP_PORT=4021
REFUND_TCP_PORT=4022
SEARCH_TCP_PORT=4023
REPORT_TCP_PORT=4024
HOTEL_TCP_PORT=4025
PAYMENT_TCP_PORT=4026
TAXI_TCP_PORT=4027
# Must equal the audit-log-service bind default in its main.ts (and the Joi
# default in api-gateway/src/config/env.validation.ts) — a mismatch is silent
# until someone runs without a .env, then every audit read 503s.
AUDIT_LOG_TCP_PORT=4028

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@kartseek.com

# ── SMS / OTP ─────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Anonymous requests must never be treated as SUPER_ADMIN anywhere but a
# developer's own shell. Keep this false in every committed file; flip it to
# true only in your local .env. See docs/guides/running-services.md#flags.
DEV_AUTH_BYPASS=false

# Return the staff sign-in code in the /auth/login response instead of only
# emailing it, so a developer with no mail provider can still finish a login and
# the verification scripts can complete the challenge. DEV_AUTH_BYPASS=true
# implies this, and NODE_ENV=production overrides both — a deployed gateway
# never echoes the code however these are set. Keep it false in committed files.
DEV_MFA_ECHO=false

# Seed superadmin@kartseek.com (UserRole.SUPER_ADMIN) on boot, with the shared
# development password every other seeded account uses. Off by default: that
# account has global control of every module, market and setting, and the seed
# otherwise runs in any environment that is merely not production — staging and
# shared dev boxes included. Turn it on only on a machine whose database nobody
# else reaches. The other seeded accounts are unaffected by this flag.
SEED_SUPER_ADMIN=false

# Interface the gateway listens on. Empty means 0.0.0.0, except while
# DEV_AUTH_BYPASS=true, when it means 127.0.0.1 so the bypass role cannot reach
# other machines on the network. Set it explicitly to override either default.
API_GATEWAY_HOST=

# Accept the static code '1234' at POST /auth/otp/verify without sending an SMS.
# Leave empty everywhere except a local machine. That endpoint creates the account
# if it does not exist and returns a session, so with this on, anyone who can
# reach the gateway can sign in as any phone number. Ignored when
# NODE_ENV=production.
ALLOW_STATIC_DEV_OTP=

# ── Push Notifications (Firebase) ─────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_KEY=

# ── Pool and retry policy ─────────────────────────────────────────────────────
# Applied by databaseCredentials() in @app/database, which every DB service
# spreads — one policy, not one per service (AUD2-033). Unset means the defaults
# in that helper; these lines only exist to name the knobs.
#
# Connections each service opens to Postgres. node-postgres defaults to 10, and
# 25 services x 10 = 250 against a max_connections of 100 — the services that
# start last then cannot acquire a connection under load. Raise this only
# alongside max_connections, or put PgBouncer in front.
DB_POOL_SIZE=5
# How long a request waits for a free connection before failing. Failing fast
# surfaces pool exhaustion as an error instead of a hung request.
DB_POOL_TIMEOUT_MS=10000
# TCP connect timeout, and how hard TypeORM retries a database that is not up
# yet. The defaults are 5000 / 3 attempts / 1500 ms in development and
# 5000 / 10 / 3000 in production, where the database may still be starting.
DB_CONNECT_TIMEOUT_MS=5000
DB_RETRY_ATTEMPTS=3
DB_RETRY_DELAY_MS=1500

# ── Database-per-service (opt in) ─────────────────────────────────────────────
#
# By default every module shares `kartseek-postgres` on 5432, using a database
# of its own inside it. That is isolation at the database level; the container
# is still shared, so one instance failing takes all of them with it and a
# runaway query on one module can starve the rest.
#
# For container-level isolation:
#
#   docker compose --profile isolated up -d       # nine Postgres instances
#   npm run db:split -w kartseek-api              # see what would be copied
#   npm run db:split -w kartseek-api -- --apply   # copy and verify per table
#
# then uncomment the block below. Each module already prefers its own
# <MODULE>_DB_* over the shared DB_*, so nothing in the code has to change.
#
# Expect 1-2 GB of memory for the databases alone. Uncommenting these while the
# containers are stopped will stop the services booting, which is why they ship
# commented out.
#
# MARKETPLACE_DB_HOST=localhost
# MARKETPLACE_DB_PORT=5433
# MARKETPLACE_DB_USER=marketplace_user
# MARKETPLACE_DB_PASSWORD=change_me_in_development
#
# GROCERY_DB_HOST=localhost
# GROCERY_DB_PORT=5434
# GROCERY_DB_USER=grocery_user
# GROCERY_DB_PASSWORD=change_me_in_development
#
# RESTAURANT_DB_HOST=localhost
# RESTAURANT_DB_PORT=5435
# RESTAURANT_DB_USER=restaurant_user
# RESTAURANT_DB_PASSWORD=change_me_in_development
#
# PHARMACY_DB_HOST=localhost
# PHARMACY_DB_PORT=5436
# PHARMACY_DB_USER=pharmacy_user
# PHARMACY_DB_PASSWORD=change_me_in_development
#
# DOCTOR_DB_HOST=localhost
# DOCTOR_DB_PORT=5437
# DOCTOR_DB_USER=doctor_user
# DOCTOR_DB_PASSWORD=change_me_in_development
#
# HOTEL_DB_HOST=localhost
# HOTEL_DB_PORT=5438
# HOTEL_DB_USER=hotel_user
# HOTEL_DB_PASSWORD=change_me_in_development
#
# TAXI_DB_HOST=localhost
# TAXI_DB_PORT=5439
# TAXI_DB_USER=taxi_user
# TAXI_DB_PASSWORD=change_me_in_development
#
# FRANCHISE_DB_HOST=localhost
# FRANCHISE_DB_PORT=5440
# FRANCHISE_DB_USER=franchise_user
# FRANCHISE_DB_PASSWORD=change_me_in_development

# ── Elasticsearch (search-service) ─────────────────────────────────────────
# ELASTICSEARCH_NODE=http://localhost:9200
# ELASTICSEARCH_INDEX_PREFIX=kartseek_
# Replicas for the kartseek_* indices, applied as an index template at start-up.
# Defaults to 0 outside production (a single node cannot place a replica, so the
# cluster stayed yellow for good) and to 1 in production.
# ELASTICSEARCH_REPLICAS=0
