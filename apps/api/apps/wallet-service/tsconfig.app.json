{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // `strictNullChecks` is enabled per service as each reaches zero, the way
    // `noImplicitAny` was rolled out before it. The root flag stays off until
    // every service is clean — see the note there for the remaining counts.
    // Remove this override once the root flag is on.
    "declaration": false,
    "outDir": "../../dist/apps/wallet-service"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*spec.ts"
  ]
}