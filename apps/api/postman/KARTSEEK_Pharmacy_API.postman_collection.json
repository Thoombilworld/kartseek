								{ "key": "lat", "value": "19.0760", "disabled": true },
								{ "key": "lng", "value": "72.8777", "disabled": true },
								{ "key": "radius", "value": "10", "disabled": true }
							]
						}
					},
					"event": [{ "listen": "test", "script": { "exec": [
						"pm.test('Returns paginated store list', () => {",
						"  pm.response.to.have.status(200);",
						"  const json = pm.response.json();",
						"  pm.expect(json).to.have.property('data');",
						"  pm.expect(json).to.have.property('total');",
						"  if (json.data && json.data.length > 0) {",
						"    pm.collectionVariables.set('storeId', json.data[0].id);",
						"  }",
