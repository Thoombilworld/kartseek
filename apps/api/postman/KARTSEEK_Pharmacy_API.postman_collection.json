							"host": ["{{BASE_URL}}"], "path": ["pharmacy", "stores"],
							"query": [
								{ "key": "lat", "value": "19.0760" },
								{ "key": "lng", "value": "72.8777" },
								{ "key": "radius", "value": "10" },
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "20" }
