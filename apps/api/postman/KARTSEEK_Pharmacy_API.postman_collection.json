					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{BASE_URL}}/pharmacy/stores/{{storeId}}", "host": ["{{BASE_URL}}"], "path": ["pharmacy", "stores", "{{storeId}}"] }
					},
					"event": [{ "listen": "test", "script": { "exec": [
						"pm.test('Store details returned', () => {",
