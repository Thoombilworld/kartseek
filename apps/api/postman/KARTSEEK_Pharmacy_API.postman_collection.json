						"  pm.expect(json).to.have.property('id');",
						"  pm.expect(json).to.have.property('name');",
						"});"
					]}}]
				},
				{
					"name": "Search Medicines",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{BASE_URL}}/pharmacy/search?q=Paracetamol&page=1&limit=20", "host": ["{{BASE_URL}}"], "path": ["pharmacy", "search"], "query": [{ "key": "q", "value": "Paracetamol" }, { "key": "page", "value": "1" }, { "key": "limit", "value": "20" }] }
					},
					"event": [{ "listen": "test", "script": { "exec": [
						"pm.test('Search returns results', () => {",
						"  pm.response.to.have.status(200);",
						"  pm.expect(pm.response.json()).to.have.property('data');",
						"});"
					]}}]
				}
			]
		},
