{
	"info": {
		"_postman_id": "kartseek-pharmacy-api-collection",
		"name": "KARTSEEK Pharmacy API",
		"description": "Complete API collection for the KARTSEEK Pharmacy service — 40 endpoints.\n\n**Setup**: Create a Postman environment with:\n- `BASE_URL` = http://localhost:3001\n- `JWT_TOKEN` = your auth token\n- `storeId`, `orderId`, `itemId`, `staffId`, `promoId`, `prescId`, `customerId`, `franchiseId`",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "BASE_URL", "value": "http://localhost:3001", "type": "string" },
		{ "key": "JWT_TOKEN", "value": "", "type": "string" },
		{ "key": "storeId", "value": "", "type": "string" },
		{ "key": "orderId", "value": "", "type": "string" },
		{ "key": "itemId", "value": "", "type": "string" },
		{ "key": "staffId", "value": "", "type": "string" },
		{ "key": "promoId", "value": "", "type": "string" },
		{ "key": "prescId", "value": "", "type": "string" },
		{ "key": "customerId", "value": "", "type": "string" },
		{ "key": "categoryId", "value": "", "type": "string" },
		{ "key": "franchiseId", "value": "", "type": "string" }
	],
	"auth": {
		"type": "bearer",
		"bearer": [{ "key": "token", "value": "{{JWT_TOKEN}}", "type": "string" }]
	},
	"event": [
		{
			"listen": "test",
			"script": {
				"exec": [
					"// Collection-level test: every response must be valid JSON and not a 404/500",
					"pm.test('Response is valid JSON (not HTML error page)', function() {",
					"  pm.response.to.be.json;",
					"  pm.expect(pm.response.code).to.not.equal(404);",
					"  pm.expect(pm.response.code).to.not.equal(500);",
					"});"
				]
			}
		}
	],
	"item": [
		{
			"name": "Health",
			"item": [
				{
					"name": "Health Check (direct)",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "http://localhost:3020/pharmacy/health", "host": ["http://localhost:3020"], "path": ["pharmacy", "health"] }
					},
					"event": [{ "listen": "test", "script": { "exec": [
						"pm.test('Pharmacy service healthy', () => {",
						"  pm.response.to.have.status(200);",
						"  const json = pm.response.json();",
						"  pm.expect(json.service).to.equal('pharmacy-service');",
						"  pm.expect(json.dbConnected).to.be.a('boolean');",
						"});"
					]}}]
				}
			]
		},
		{
			"name": "Customer - Home",
			"item": [
				{
					"name": "Pharmacy Home",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{BASE_URL}}/pharmacy/home", "host": ["{{BASE_URL}}"], "path": ["pharmacy", "home"] }
					},
					"event": [{ "listen": "test", "script": { "exec": [
						"pm.test('Home returns stores, categories, promotions', () => {",
						"  pm.response.to.have.status(200);",
						"  const json = pm.response.json();",
						"  pm.expect(json).to.have.property('featuredStores');",
						"  pm.expect(json).to.have.property('categories');",
						"  pm.expect(json).to.have.property('promotions');",
						"});"
					]}}]
				}
			]
		},
		{
