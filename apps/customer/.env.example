# KARTSEEK Customer App — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── Google Maps ──────────────────────────────────────────────────────────────
# Required for: Taxi booking, Grocery store maps, Restaurant maps
# Get your key at: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# ── API Configuration ────────────────────────────────────────────────────────
# Backend API Gateway URL (NestJS)
API_BASE_URL=http://127.0.0.1:3001/api/v1

# WebSocket server URL
WS_BASE_URL=ws://127.0.0.1:3001

# ── Release Signing (Android) ────────────────────────────────────────────────
# Path to your release keystore file
KEYSTORE_PATH=kartseek-release.keystore
KEYSTORE_PASSWORD=
KEY_ALIAS=kartseek
KEY_PASSWORD=

# ── Firebase (optional — for push notifications) ─────────────────────────────
# FIREBASE_PROJECT_ID=
# FIREBASE_API_KEY=
