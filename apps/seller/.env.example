# KARTSEEK Seller App — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── API Configuration ────────────────────────────────────────────────────────
# Backend API Gateway URL (NestJS)
API_BASE_URL=http://127.0.0.1:3001/api/v1

# WebSocket server URL (real-time seller order + booking events)
WS_BASE_URL=ws://127.0.0.1:3001

# ── WebRTC (Doctor Module) ───────────────────────────────────────────────────
# STUN servers for WebRTC peer connection (Google public STUN — safe to use)
STUN_SERVER_URL=stun:stun.l.google.com:19302
# TURN server (optional — for NAT traversal in production)
# TURN_SERVER_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# ── File Uploads (Pharmacy Prescriptions, Product Images) ────────────────────
# Signed upload URL endpoint (returns a pre-signed S3/GCS URL)
UPLOAD_ENDPOINT=/upload/signed-url

# ── Release Signing (Android) ────────────────────────────────────────────────
KEYSTORE_PATH=kartseek-seller-release.keystore
KEYSTORE_PASSWORD=
KEY_ALIAS=kartseek-seller
KEY_PASSWORD=

# ── Firebase (optional — for push notifications) ─────────────────────────────
# FIREBASE_PROJECT_ID=
# FIREBASE_API_KEY=
