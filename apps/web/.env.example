# The web shell (apps/web) reads apps/web/.env.local. Copy this file there:
#
#   cp apps/web/.env.example apps/web/.env.local
#
# Nothing here is secret (every value is NEXT_PUBLIC_ or a localhost origin),
# so copying by hand is fine — unlike the root .env and apps/api/.env, which
# `npm run env:init` generates because they carry passwords and JWT secrets.
#
# The eight zones under modules/*/frontend are separate Next.js apps and do
# NOT read this file; each has its own .env.example. Keep the region values
# in step across all of them and with ACTIVE_REGIONS on the gateway — a zone
# that offers a market the shell refuses snaps the country picker back.

# Gateway. The URL includes the /api/v1 prefix; resolve it through
# lib/config/api-base.ts, never process.env directly. The WebSocket origin is
# the bare gateway origin (no prefix).
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Markets the storefront trades in, and the one a new visitor lands on.
NEXT_PUBLIC_ACTIVE_REGIONS=QA,IN,AE,SA
NEXT_PUBLIC_DEFAULT_REGION=QA

NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=KARTSEEK

# Browser-side Google Maps (address picker, nearby vendors). Restrict the key
# by HTTP referrer in the Google Cloud console; leave empty to run without maps.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Search-console ownership tokens rendered into <head>; leave empty locally.
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# Where the shell rewrites each zone's path prefix. Defaults are the dev ports
# from services.yaml; set them only when a zone runs elsewhere (a container,
# a preview deployment). Build-time in the Docker image — see
# docs/guides/troubleshooting.md before overriding at runtime.
# MARKETPLACE_ZONE_ORIGIN=http://localhost:3002
# GROCERY_ZONE_ORIGIN=http://localhost:3003
# RESTAURANT_ZONE_ORIGIN=http://localhost:3004
# PHARMACY_ZONE_ORIGIN=http://localhost:3005
# DOCTOR_ZONE_ORIGIN=http://localhost:3006
# HOTEL_ZONE_ORIGIN=http://localhost:3007
# TAXI_ZONE_ORIGIN=http://localhost:3008
# FRANCHISE_ZONE_ORIGIN=http://localhost:3009
