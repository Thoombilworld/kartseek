{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "main",
  "compilerOptions": {
    "tsConfigPath": "tsconfig.app.json",
    "typeCheck": false,
    "deleteOutDir": true,
    "builder": {
      "type": "rspack",
      "options": {
        "configPath": "rspack.config.js"
      }
    }
  }
}
