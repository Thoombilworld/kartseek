{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "main",
  "compilerOptions": {
    "webpack": true,
    "webpackConfigPath": "webpack.config.js",
    "tsConfigPath": "tsconfig.app.json",
    "typeCheck": false,
    "deleteOutDir": true,
    "assets": [
      { "include": "../../../apps/api/proto/**/*.proto", "outDir": "./dist/proto", "watchAssets": true }
    ]
  }
}
