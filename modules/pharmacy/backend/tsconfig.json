{
  "compilerOptions": {
    /**
     * `isolatedModules` makes TypeScript itself reject what the rspack builder
     * cannot compile. swc transpiles each file alone, so a type-only binding
     * imported as a value emits a runtime import that fails to link — the
     * builder reports it, but only at build time and only for files it
     * reaches. With this on, `tsc --noEmit` reports it everywhere, first.
     */
    "isolatedModules": true,
    // The repo root, because the shared @app/* libraries live outside this
    // module. Left to infer, TypeScript derives it from `include` (src/**/*)
    // and then rejects every lib file with TS6059. Emit is rspack's job
    // (nest build bundles to a single main.js), so this only shapes the
    // type-check program.
    "rootDir": "../../..",
    "esModuleInterop": true,
    "types": ["jest", "node"],
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,

    // Mirrors apps/api/tsconfig.json. `strictPropertyInitialization` stays off
    // for the same reason it is off there: NestJS DTOs are built by
    // ValidationPipe from the request body, never by a constructor we write, so
    // the check fires on every field of every DTO and means nothing.
    "strictPropertyInitialization": false,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": true,

    // The platform libraries stay shared. Pharmacy consumes nine of them
    // (@app/redis, kafka, security, common, region, guards, grpc, decorators,
    // database) and they are a stable internal platform SDK, not pharmacy
    // code — vendoring a private copy per service is how twenty-five copies of
    // one auth guard drift apart. `baseUrl` is deliberately absent here, same
    // as apps/api: TypeScript 6 deprecates it and `tsc --noEmit` rejects it, so
    // rspack resolves these through explicit aliases (and these `paths`).
    "paths": {
      "@app/common":      ["../../../apps/api/libs/common/src"],
      "@app/common/*":    ["../../../apps/api/libs/common/src/*"],
      "@app/database":    ["../../../apps/api/libs/database/src"],
      "@app/database/*":  ["../../../apps/api/libs/database/src/*"],
      "@app/guards":      ["../../../apps/api/libs/guards/src"],
      "@app/guards/*":    ["../../../apps/api/libs/guards/src/*"],
      "@app/decorators":  ["../../../apps/api/libs/decorators/src"],
      "@app/decorators/*":["../../../apps/api/libs/decorators/src/*"],
      "@app/validators":  ["../../../apps/api/libs/validators/src"],
      "@app/validators/*":["../../../apps/api/libs/validators/src/*"],
      "@app/dto":         ["../../../apps/api/libs/dto/src"],
      "@app/dto/*":       ["../../../apps/api/libs/dto/src/*"],
      "@app/events":      ["../../../apps/api/libs/events/src"],
      "@app/events/*":    ["../../../apps/api/libs/events/src/*"],
      "@app/logger":      ["../../../apps/api/libs/logger/src"],
      "@app/logger/*":    ["../../../apps/api/libs/logger/src/*"],
      "@app/security":    ["../../../apps/api/libs/security/src"],
      "@app/security/*":  ["../../../apps/api/libs/security/src/*"],
      "@app/grpc":        ["../../../apps/api/libs/grpc/src"],
      "@app/grpc/*":      ["../../../apps/api/libs/grpc/src/*"],
      "@app/kafka":       ["../../../apps/api/libs/kafka/src"],
      "@app/kafka/*":     ["../../../apps/api/libs/kafka/src/*"],
      "@app/redis":       ["../../../apps/api/libs/redis/src"],
      "@app/redis/*":     ["../../../apps/api/libs/redis/src/*"],
      "@app/gdpr":        ["../../../apps/api/libs/gdpr/src"],
      "@app/gdpr/*":      ["../../../apps/api/libs/gdpr/src/*"],
      "@app/region":      ["../../../apps/api/libs/region/src"],
      "@app/region/*":    ["../../../apps/api/libs/region/src/*"],
      "@app/storage":     ["../../../apps/api/libs/storage/src"],
      "@app/storage/*":   ["../../../apps/api/libs/storage/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
