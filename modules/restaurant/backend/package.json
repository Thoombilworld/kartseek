{
  "name": "@kartseek/restaurant-backend",
  "version": "1.0.0",
  "private": true,
  "description": "KARTSEEK Restaurant — independent backend microservice (HTTP 3019 · TCP 4018 · gRPC 5005)",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "dev": "nest start --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit -p tsconfig.json && npm run check:type-imports",
    "check:type-imports": "node ../../../scripts/check-type-imports.js .",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "clean": "rimraf dist",
    "migration:show": "typeorm-ts-node-commonjs -d data-source.ts migration:show",
    "migration:run": "typeorm-ts-node-commonjs -d data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d data-source.ts migration:revert"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/../../../apps/api/libs/common/src/$1",
      "^@app/database(|/.*)$": "<rootDir>/../../../apps/api/libs/database/src/$1",
      "^@app/redis(|/.*)$": "<rootDir>/../../../apps/api/libs/redis/src/$1",
      "^@app/kafka(|/.*)$": "<rootDir>/../../../apps/api/libs/kafka/src/$1",
      "^@app/grpc(|/.*)$": "<rootDir>/../../../apps/api/libs/grpc/src/$1",
      "^@app/security(|/.*)$": "<rootDir>/../../../apps/api/libs/security/src/$1",
      "^uuid$": "<rootDir>/../../../apps/api/test/uuid-mock.ts",
      "^@app/([^/]+)(|/.*)$": "<rootDir>/../../../apps/api/libs/$1/src/$2"
    }
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/microservices": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  }
}
