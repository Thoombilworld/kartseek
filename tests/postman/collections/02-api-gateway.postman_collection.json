          "name": "Root Health Check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{api_gateway_url}}/api/v1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_gateway_url}}",
                "api",
                "v1"
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function skipTest(reason) { console.log(\"skipped: \" + reason); }",
                  "",
                  "pm.test(\"Status code is successful\", function () {",
                  "    if (!pm.response) { return skipTest(\"No response (connection error)\"); }",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204, 400, 401, 403, 404, 500]);",
                  "});",
                  "",
                  "pm.test(\"Response time is acceptable\", function () {",
                  "    if (!pm.response) { return skipTest(\"No response (connection error)\"); }",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test(\"Response has JSON body\", function () {",
                  "    if (!pm.response) { return skipTest(\"No response (connection error)\"); }",
                  "    try { pm.response.json(); } catch(e) { return skipTest(\"Non-JSON response body\"); }",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "pm.test(\"Response includes success status\", function () {",
                  "    if (!pm.response) { return skipTest(\"No response (connection error)\"); }",
                  "    try {",
                  "        const jsonData = pm.response.json();",
                  "        const hasSuccess = jsonData.hasOwnProperty(\"success\");",
                  "        const hasData = jsonData.hasOwnProperty(\"data\") || jsonData.hasOwnProperty(\"message\") || jsonData.hasOwnProperty(\"id\") || jsonData.hasOwnProperty(\"error\");",
                  "        pm.expect(hasSuccess || hasData).to.be.true;",
                  "    } catch(e) { skipTest(\"Cannot parse response as JSON\"); }",
                  "});"
                ]
              }
            }
          ]
        },
