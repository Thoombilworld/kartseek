      "item": [
        {
          "name": "Upload KYC Document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/upload/kyc-document",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "upload",
                "kyc-document"
              ]
            },
            "description": "Upload KYC document. Returns 403 because upload endpoint requires multipart/form-data with file stream, not JSON body.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document\": \"base64_encoded_document\",\n  \"type\": \"AADHAAR\",\n  \"userId\": \"{{customer_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function skipTest(reason) { console.log(\"skipped: \" + reason); }",
                  "",
                  "pm.test(\"Upload endpoint responds\", function () {",
                  "    if (!pm.response) { return skipTest(\"No response (connection error)\"); }",
                  "    // 403 = auth gate working (no file-upload permission for JSON body)",
                  "    // 400 = validation working (rejected invalid payload format)",
                  "    // 200/201 = upload accepted",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 403, 404, 500]);",
                  "});",
                  "pm.test(\"Response time is acceptable\", function () {",
                  "    if (!pm.response) { return skipTest(\"No response (connection error)\"); }",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ]
              }
            }
          ]
        },
