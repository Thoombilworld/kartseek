                  "pm.test('Has total count', () => pm.expect(body.data.total).to.be.a('number'));",
                  "pm.test('At least 1 booking', () => pm.expect(body.data.total).to.be.at.least(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.6 Modify Booking",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/hotels/bookings/{{booking_id}}/modify",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"checkin\": \"2026-08-02\",\n  \"checkout\": \"2026-08-05\",\n  \"specialRequests\": \"Late checkout requested\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Modification successful', () => pm.expect(body.data.success).to.be.true);",
                  "pm.test('Status changed to MODIFIED', () => pm.expect(body.data.booking.status).to.eql('MODIFIED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.7 Cancel Booking",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/hotels/bookings/{{booking_id}}/cancel",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Change of travel plans\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Cancellation successful', () => pm.expect(body.data.success).to.be.true);",
                  "pm.test('Status is CANCELLED', () => pm.expect(body.data.status).to.eql('CANCELLED'));",
                  "pm.test('Has refund info', () => { pm.expect(body.data.refundAmount).to.be.a('number'); pm.expect(body.data.currency).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "3.8 Cancel Already-Cancelled Booking (400 test)",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/hotels/bookings/{{booking_id}}/cancel",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{ \"reason\": \"Trying again\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 or 500 (already cancelled)', () => pm.expect(pm.response.code).to.be.oneOf([400, 500]));",
                  "pm.test('Has error message', () => pm.expect(pm.response.json().message || pm.response.json().data).to.exist);"
                ]
              }
            }
          ]
        }
      ]
    },
