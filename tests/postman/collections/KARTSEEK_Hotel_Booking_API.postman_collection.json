{
  "info": {
    "_postman_id": "kartseek-hotel-booking-v1",
    "name": "🏨 KARTSEEK Hotel Booking API",
    "description": "Comprehensive API testing collection for the KARTSEEK Hotel Booking Module.\n\n## Getting Started\n1. Set the `base_url` variable to your API gateway URL (default: `http://localhost:3001/api/v1`)\n2. Run the **Health Check** request first to confirm connectivity\n3. Run **Search Hotels** to get real hotel IDs and populate variables\n4. Follow the numbered test flows sequentially\n\n## Test Coverage\n- ✅ Status codes (200, 201, 400, 404)\n- ✅ Payload validation (required fields, types)\n- ✅ Response structure validation\n- ✅ Response time assertions (<2s)\n- ✅ Error handling (invalid IDs, missing fields)\n- ✅ Full booking lifecycle (create → get → modify → cancel)\n- ✅ Owner portal operations\n- ✅ Admin panel operations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3001/api/v1", "type": "string" },
    { "key": "hotel_id", "value": "", "type": "string" },
    { "key": "room_id", "value": "", "type": "string" },
    { "key": "booking_id", "value": "", "type": "string" },
    { "key": "owner_id", "value": "owner-001", "type": "string" },
    { "key": "customer_id", "value": "cust-test-001", "type": "string" },
    { "key": "review_id", "value": "", "type": "string" },
    { "key": "auth_token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "🔧 1. Health & Connectivity",
      "description": "Verify that the hotel service is running and connected to all dependencies.",
      "item": [
        {
          "name": "1.1 Hotel Service Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/hotels/health",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response time < 500ms', () => pm.expect(pm.response.responseTime).to.be.below(500));",
                  "const body = pm.response.json();",
                  "pm.test('Service is hotel-service', () => pm.expect(body.data.service).to.eql('hotel-service'));",
                  "pm.test('Status is ok', () => pm.expect(body.data.status).to.eql('ok'));",
                  "pm.test('Database is connected', () => pm.expect(body.data.db).to.be.true);",
                  "pm.test('Has timestamp', () => pm.expect(body.data.timestamp).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 API Gateway Health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response time < 500ms', () => pm.expect(pm.response.responseTime).to.be.below(500));",
                  "const body = pm.response.json();",
                  "pm.test('Gateway service name', () => pm.expect(body.data.service).to.eql('api-gateway'));",
                  "pm.test('Status ok', () => pm.expect(body.data.status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "🔍 2. Search & Discovery",
      "description": "Test hotel search, filtering, and detail retrieval endpoints.",
      "item": [
        {
          "name": "2.1 Search All Hotels (no filter)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/hotels",
              "host": ["{{base_url}}"],
              "path": ["hotels"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response time < 2s', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "const body = pm.response.json();",
                  "pm.test('Has data array', () => pm.expect(body.data.data).to.be.an('array'));",
                  "pm.test('Has total count', () => pm.expect(body.data.total).to.be.a('number'));",
                  "pm.test('Has pagination', () => { pm.expect(body.data.page).to.exist; pm.expect(body.data.limit).to.exist; });",
                  "pm.test('Hotels have required fields', () => {",
                  "  const h = body.data.data[0];",
                  "  pm.expect(h.id).to.be.a('string');",
                  "  pm.expect(h.name).to.be.a('string');",
                  "  pm.expect(h.slug).to.be.a('string');",
                  "  pm.expect(h.city).to.be.a('string');",
                  "  pm.expect(h.rating).to.exist;",
                  "});",
                  "// Save first hotel ID for subsequent requests",
                  "if (body.data.data.length > 0) {",
                  "  pm.collectionVariables.set('hotel_id', body.data.data[0].id);",
                  "  // Save first room ID if rooms are populated",
                  "  if (body.data.data[0].rooms && body.data.data[0].rooms.length > 0) {",
                  "    pm.collectionVariables.set('room_id', body.data.data[0].rooms[0].id);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Search by City (Dubai)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/hotels?city=Dubai",
              "host": ["{{base_url}}"],
              "path": ["hotels"],
              "query": [{ "key": "city", "value": "Dubai" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Results contain Dubai hotels', () => {",
                  "  body.data.data.forEach(h => {",
                  "    pm.expect(h.city.toLowerCase()).to.include('dubai');",
                  "  });",
                  "});",
                  "pm.test('At least 1 result', () => pm.expect(body.data.total).to.be.at.least(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Search by Star Rating (5 stars)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/hotels?starRating=5",
              "host": ["{{base_url}}"],
              "path": ["hotels"],
              "query": [{ "key": "starRating", "value": "5" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('All results are 5-star', () => {",
                  "  body.data.data.forEach(h => pm.expect(h.starRating).to.eql(5));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 Search with Price Range",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/hotels?minPrice=200&maxPrice=900",
              "host": ["{{base_url}}"],
              "path": ["hotels"],
              "query": [
                { "key": "minPrice", "value": "200" },
                { "key": "maxPrice", "value": "900" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response time < 2s', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.5 Search with Pagination",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/hotels?page=1&limit=3",
              "host": ["{{base_url}}"],
              "path": ["hotels"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "3" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Respects limit', () => pm.expect(body.data.data.length).to.be.at.most(3));",
                  "pm.test('Page is 1', () => pm.expect(body.data.page).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.6 Get Hotel Details by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/hotels/{{hotel_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response time < 1s', () => pm.expect(pm.response.responseTime).to.be.below(1000));",
                  "const body = pm.response.json();",
                  "const h = body.data;",
                  "pm.test('Has hotel name', () => pm.expect(h.name).to.be.a('string'));",
                  "pm.test('Has amenities array', () => pm.expect(h.amenities).to.be.an('array'));",
                  "pm.test('Has rooms array', () => pm.expect(h.rooms).to.be.an('array'));",
                  "pm.test('Has reviews array', () => pm.expect(h.reviews).to.be.an('array'));",
                  "pm.test('Has location data', () => { pm.expect(h.latitude).to.exist; pm.expect(h.longitude).to.exist; });",
                  "pm.test('Has cancellation policy', () => pm.expect(h.cancellationPolicy).to.be.an('object'));",
                  "// Save room ID for booking test",
                  "if (h.rooms && h.rooms.length > 0) {",
                  "  pm.collectionVariables.set('room_id', h.rooms[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2.7 Get Hotel — Invalid ID (404 test)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/hotels/00000000-0000-0000-0000-000000000000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404 or 500', () => pm.expect(pm.response.code).to.be.oneOf([404, 500]));",
                  "const body = pm.response.json();",
                  "pm.test('Has error message', () => pm.expect(body.message || body.data?.message).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.8 Get Room Availability",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/hotels/{{hotel_id}}/rooms?checkin=2026-07-15&checkout=2026-07-18&guests=2",
              "host": ["{{base_url}}"],
              "path": ["hotels", "{{hotel_id}}", "rooms"],
              "query": [
                { "key": "checkin", "value": "2026-07-15" },
                { "key": "checkout", "value": "2026-07-18" },
                { "key": "guests", "value": "2" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const d = body.data;",
                  "pm.test('Has rooms array', () => pm.expect(d.rooms).to.be.an('array'));",
                  "pm.test('Has nights count', () => pm.expect(d.nights).to.be.a('number'));",
                  "pm.test('Each room has pricing', () => {",
                  "  d.rooms.forEach(r => {",
                  "    pm.expect(r.pricePerNight).to.be.a('number');",
                  "    pm.expect(r.totalPrice).to.be.a('number');",
                  "    pm.expect(r.available).to.be.a('number');",
                  "  });",
                  "});",
                  "if (d.rooms.length > 0) {",
                  "  pm.collectionVariables.set('room_id', d.rooms[0].id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "📅 3. Booking Lifecycle",
      "description": "Full booking flow: create → retrieve → modify → cancel. Tests the complete lifecycle.",
      "item": [
        {
          "name": "3.1 Create Booking ✅",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/hotels/{{hotel_id}}/bookings",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customer_id}}\",\n  \"roomId\": \"{{room_id}}\",\n  \"checkin\": \"2026-08-01\",\n  \"checkout\": \"2026-08-04\",\n  \"guests\": 2,\n  \"rooms\": 1,\n  \"paymentMethod\": \"ONLINE\",\n  \"guestName\": \"John Smith\",\n  \"guestEmail\": \"john.smith@test.com\",\n  \"guestPhone\": \"+971501234567\",\n  \"specialRequests\": \"High floor, late check-in\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.test('Response time < 2s', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "const body = pm.response.json();",
                  "pm.test('Booking created successfully', () => pm.expect(body.data.success).to.be.true);",
                  "pm.test('Has booking object', () => pm.expect(body.data.booking).to.be.an('object'));",
                  "pm.test('Has booking ID', () => pm.expect(body.data.booking.id).to.be.a('string'));",
                  "pm.test('Has confirmation code', () => pm.expect(body.data.booking.confirmationCode).to.be.a('string'));",
                  "pm.test('Status is CONFIRMED', () => pm.expect(body.data.booking.status).to.eql('CONFIRMED'));",
                  "pm.test('Grand total > 0', () => pm.expect(Number(body.data.booking.grandTotal)).to.be.above(0));",
                  "// Save booking ID for subsequent tests",
                  "pm.collectionVariables.set('booking_id', body.data.booking.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Create Booking — Missing Fields (400 test)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/hotels/{{hotel_id}}/bookings",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": \"{{room_id}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 or 500 (validation error)', () => pm.expect(pm.response.code).to.be.oneOf([400, 500]));",
                  "pm.test('Has error response', () => pm.expect(pm.response.json().success).to.be.false);"
                ]
              }
            }
          ]
        },
        {
          "name": "3.3 Create Booking — Invalid Hotel (404 test)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/hotels/00000000-0000-0000-0000-000000000000/bookings",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"cust-001\",\n  \"roomId\": \"{{room_id}}\",\n  \"checkin\": \"2026-08-01\",\n  \"checkout\": \"2026-08-04\",\n  \"guests\": 2,\n  \"rooms\": 1,\n  \"paymentMethod\": \"ONLINE\",\n  \"guestName\": \"Test\",\n  \"guestEmail\": \"test@test.com\",\n  \"guestPhone\": \"+971500000000\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404 or 500', () => pm.expect(pm.response.code).to.be.oneOf([404, 500]));",
                  "pm.test('Has error message', () => { const body = pm.response.json(); pm.expect(body.message || body.data).to.exist; });"
                ]
              }
            }
          ]
        },
        {
          "name": "3.4 Get Booking by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/hotels/bookings/{{booking_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response time < 1s', () => pm.expect(pm.response.responseTime).to.be.below(1000));",
                  "const body = pm.response.json();",
                  "pm.test('Booking has correct ID', () => pm.expect(body.data.id).to.eql(pm.collectionVariables.get('booking_id')));",
                  "pm.test('Has status field', () => pm.expect(body.data.status).to.be.a('string'));",
                  "pm.test('Has hotel relation', () => pm.expect(body.data.hotel).to.be.an('object'));",
                  "pm.test('Has room relation', () => pm.expect(body.data.room).to.be.an('object'));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.5 Get User Bookings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/hotels/bookings/user/{{customer_id}}?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["hotels", "bookings", "user", "{{customer_id}}"],
              "query": [
                { "key": "page", "value": "1" },
