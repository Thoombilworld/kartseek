    },
    {
      "name": "05 — Taxi Real-Time Billing",
      "item": [
        {
          "name": "Pre-Authorize Taxi Ride",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/taxi/preauth",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"rideId\":\"RIDE-001\",\"customerId\":\"USER-001\",\"estimatedFare\":350,\"currency\":\"INR\",\"countryCode\":\"IN\",\"methodType\":\"upi\"}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Pre-auth created with 20% buffer', () => {",
                "  pm.response.to.have.status(201);",
                "  const body = pm.response.json();",
                "  const d = body.data || body;",
                "  pm.expect(d.success).to.be.true;",
                "  pm.expect(d.holdAmount).to.be.at.least(350);",
                "  pm.expect(d.rideId).to.eql('RIDE-001');",
                "  pm.collectionVariables.set('rideId', d.rideId);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Get Billing State",
          "request": { "method": "GET", "url": "{{baseUrl}}/taxi/billing/RIDE-001" },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Billing state returned', () => {",
                "  pm.response.to.have.status(200);",
                "  const body = pm.response.json();",
                "  const d = body.data || body;",
                "  pm.expect(d.rideId).to.eql('RIDE-001');",
                "  pm.expect(d).to.have.property('holdAmount');",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Capture Final Fare",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/taxi/capture",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"rideId\":\"RIDE-001\",\"finalFare\":320,\"tipAmount\":30,\"discount\":20}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Final fare captured', () => {",
                "  const status = pm.response.code;",
                "  pm.expect(status).to.be.oneOf([200, 201]);",
                "  const body = pm.response.json();",
                "  const d = body.data || body;",
                "  pm.expect(d.success).to.be.true;",
                "  pm.expect(d.capturedAmount).to.eql(330);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Cancel Billing (with fee)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/taxi/cancel-billing",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"rideId\":\"RIDE-002\",\"cancellationFee\":50,\"cancelledBy\":\"rider\"}"
            }
