                "  const body = pm.response.json();",
                "  const d = body.data || body;",
                "  pm.expect(d.date).to.eql('2026-07-07');",
                "  pm.expect(d).to.have.property('isBalanced');",
                "  pm.expect(d).to.have.property('discrepancy');",
                "});"
              ]
            }
          }]
        }
      ]
    },
