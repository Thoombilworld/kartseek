{
  "info": {
    "name": "KARTSEEK Centralized Payment Service",
    "description": "Comprehensive API test suite for the centralized payment microservice covering payment lifecycle, region-based methods, taxi billing, invoicing, settlements, and security.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001/api/v1/payments" },
    { "key": "paymentId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "invoiceId", "value": "" },
    { "key": "rideId", "value": "" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "exec": [
          "// Global helper: unwrap TransformInterceptor response.",
          "// GET (200) responses are wrapped as { success, data, timestamp }.",
          "// POST (201) responses return raw controller output.",
          "pm.globals.set('_unwrap', `function unwrap(body) { return body.data !== undefined ? body.data : body; }`);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 — Health Check",
      "item": [
        {
          "name": "Payment Service Health",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Service is healthy', () => {",
                "  pm.response.to.have.status(200);",
                "  const body = pm.response.json();",
                "  const d = body.data || body;",
                "  pm.expect(d.status).to.eql('ok');",
                "  pm.expect(d.service).to.eql('payment-service');",
                "});"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "02 — Payment Method Discovery",
      "item": [
        {
          "name": "Get India Payment Methods",
          "request": { "method": "GET", "url": "{{baseUrl}}/methods/IN" },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Returns Indian payment methods', () => {",
                "  pm.response.to.have.status(200);",
                "  const body = pm.response.json();",
                "  const methods = body.data || body;",
                "  pm.expect(methods).to.be.an('array');",
                "  const upi = methods.find(m => m.methodType === 'upi');",
                "  pm.expect(upi).to.not.be.undefined;",
                "  pm.expect(upi.gateway).to.eql('upi');",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Get UAE Payment Methods",
          "request": { "method": "GET", "url": "{{baseUrl}}/methods/AE" },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Returns UAE payment methods (no UPI)', () => {",
                "  pm.response.to.have.status(200);",
                "  const body = pm.response.json();",
                "  const methods = body.data || body;",
                "  pm.expect(methods).to.be.an('array');",
                "  const upi = methods.find(m => m.methodType === 'upi');",
                "  pm.expect(upi).to.be.undefined;",
                "  const card = methods.find(m => m.methodType === 'card');",
                "  pm.expect(card).to.not.be.undefined;",
                "  pm.expect(card.gateway).to.eql('stripe');",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Get India Payment Methods",
          "request": { "method": "GET", "url": "{{baseUrl}}/methods/KE" },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Returns Indian payment methods with UPI', () => {",
                "  pm.response.to.have.status(200);",
                "  const body = pm.response.json();",
                "  const methods = body.data || body;",
                "  pm.expect(methods).to.be.an('array');",
                "  const upi = methods.find(m => m.methodType === 'upi');",
                "  pm.expect(upi).to.not.be.undefined;",
                "  pm.expect(upi.isDefault).to.be.true;",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Get Saudi Payment Methods",
          "request": { "method": "GET", "url": "{{baseUrl}}/methods/SA" },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Returns Saudi payment methods with Mada', () => {",
                "  pm.response.to.have.status(200);",
                "  const body = pm.response.json();",
                "  const methods = body.data || body;",
                "  pm.expect(methods).to.be.an('array');",
                "  const mada = methods.find(m => m.methodType === 'mada');",
                "  pm.expect(mada).to.not.be.undefined;",
                "});"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "03 — Payment Lifecycle",
      "item": [
        {
          "name": "Initiate UPI Payment (India)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/initiate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"module\":\"marketplace\",\"orderId\":\"ORD-TEST-001\",\"customerId\":\"USER-001\",\"amount\":1499,\"currency\":\"INR\",\"countryCode\":\"IN\",\"methodType\":\"upi\",\"callbackUrl\":\"https://kartseek.com/payment/callback\"}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('UPI payment initiated with intent link', () => {",
                "  pm.response.to.have.status(201);",
                "  const body = pm.response.json();",
                "  const d = body.data || body;",
                "  pm.expect(d.success).to.be.true;",
                "  pm.expect(d.paymentId).to.be.a('string');",
                "  pm.expect(d.gateway).to.eql('razorpay');",
                "  pm.expect(d.upiIntentLink).to.match(/^upi:\\/\\/pay/);",
                "  pm.collectionVariables.set('paymentId', d.paymentId);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Initiate Card Payment (UAE)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/initiate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"module\":\"hotel\",\"orderId\":\"BOOK-UAE-001\",\"customerId\":\"USER-002\",\"amount\":895,\"currency\":\"AED\",\"countryCode\":\"AE\",\"methodType\":\"card\"}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Card payment initiated via Stripe', () => {",
                "  pm.response.to.have.status(201);",
                "  const body = pm.response.json();",
                "  const d = body.data || body;",
                "  pm.expect(d.success).to.be.true;",
                "  pm.expect(d.gateway).to.eql('stripe');",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Verify Payment",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/verify",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"paymentId\":\"{{paymentId}}\",\"gatewayRef\":\"pay_test_123\",\"signature\":\"test_sig\"}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Payment verified', () => {",
                "  const status = pm.response.code;",
                "  pm.expect(status).to.be.oneOf([200, 201]);",
                "  const body = pm.response.json();",
                "  const d = body.data || body;",
                "  pm.expect(d.success).to.be.true;",
                "  pm.expect(d.status).to.eql('completed');",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Get Payment by ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/test-payment-001" },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Payment details returned', () => {",
                "  pm.response.to.have.status(200);",
                "  const body = pm.response.json();",
                "  const d = body.data || body;",
                "  pm.expect(d).to.have.property('status');",
                "  pm.expect(d).to.have.property('amount');",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Get Payment by Order",
          "request": { "method": "GET", "url": "{{baseUrl}}/order/ORD-TEST-001" },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Payment found by orderId', () => {",
                "  pm.response.to.have.status(200);",
                "  const body = pm.response.json();",
                "  const d = body.data || body;",
                "  pm.expect(d.orderId).to.eql('ORD-TEST-001');",
                "  pm.expect(d).to.have.property('paymentId');",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Get Customer Payments",
          "request": { "method": "GET", "url": "{{baseUrl}}/customer/USER-001?page=1&limit=10" },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Customer payment history returned', () => {",
                "  pm.response.to.have.status(200);",
                "  const body = pm.response.json();",
                "  const d = body.data || body;",
                "  pm.expect(d).to.have.property('data');",
                "  pm.expect(d).to.have.property('total');",
                "});"
              ]
            }
          }]
        }
      ]
    },
